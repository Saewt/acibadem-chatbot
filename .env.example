POSTGRES_DB=acu_chatbot
POSTGRES_USER=acu_user
POSTGRES_PASSWORD=acu_password
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
LLM_BACKEND=ollama
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:8b
LLM_THINK=False
LLM_WARMUP_ENABLED=False
LLM_MAX_TOKENS=1536
LLM_TIMEOUT=60
LLM_MAX_CONCURRENT_REQUESTS=1
LLM_QUEUE_TIMEOUT=0
ANSWER_MODE=hybrid
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BACKEND=api
EMBEDDING_API_URL=http://host.docker.internal:8001
EMBEDDING_API_TIMEOUT=30
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=2
TORCH_NUM_THREADS=1
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TTL=3600
RAG_RETRIEVE_LIMIT=6
RAG_PER_PAGE_LIMIT=3
RAG_MAX_CHUNK_CHARS=800
RAG_MAX_CONTEXT_CHARS=3600
RAG_VECTOR_DISTANCE_STRICT=0.72
RAG_VECTOR_DISTANCE_BROAD=0.85
RAG_RRF_K=60
RAG_QUERY_EXPANSION_ENABLED=True
RERANK_ENABLED=True
RERANK_CANDIDATE_LIMIT=18
RERANK_OUTPUT_LIMIT=12
RERANK_MIN_SCORE=-100.0
RERANK_API_TIMEOUT=30
SEMANTIC_TOPIC_ENABLED=True
SEMANTIC_TOPIC_THRESHOLD=0.55
ACIBADEM_DATASET_HOST_ROOT=./data/acibadem-dataset
ACIBADEM_DATASET_ROOT=/data/acibadem-dataset
KNOWLEDGE_BOOTSTRAP_ENABLED=True
KNOWLEDGE_BOOTSTRAP_FAIL_ON_MISSING_DATA=True
KNOWLEDGE_SYNC_ENABLED=False
KNOWLEDGE_SYNC_RUN_ON_START=False
KNOWLEDGE_SYNC_INTERVAL_HOURS=168
KNOWLEDGE_SCHEDULER_POLL_SECONDS=300
